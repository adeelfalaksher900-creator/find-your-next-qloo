{
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/app.js",
      "destination": "/public/app.js"
    },
    {
      "source": "/core.js",
      "destination": "/public/core.js"
    },
    {
      "source": "/style.css",
      "destination": "/public/style.css"
    },
    {
      "source": "/favicon.svg",
      "destination": "/public/favicon.svg"
    },
    {
      "source": "/artwork-fallback.svg",
      "destination": "/public/artwork-fallback.svg"
    },
    {
      "source": "/cloud.js",
      "destination": "/public/cloud.js"
    },
    {
      "source": "/instrument.js",
      "destination": "/public/instrument.js"
    },
    {
      "source": "/instrument.css",
      "destination": "/public/instrument.css"
    },
    {
      "source": "/media.js",
      "destination": "/public/media.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://sttc.gamersgate.com https://static.tvmaze.com https://covers.openlibrary.org https://archive.org https://*.us.archive.org https://shared.fastly.steamstatic.com https://cdn.cloudflare.steamstatic.com https://images.gog-statics.com https://cdn.akamai.steamstatic.com; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
